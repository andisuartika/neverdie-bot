# ====== Discord ======
# Dari Discord Developer Portal -> aplikasi bot Bli
DISCORD_TOKEN=isi_token_bot_di_sini
DISCORD_CLIENT_ID=isi_application_id
GUILD_ID=isi_id_server_NEVER_DIE

# ====== 9router (endpoint kompatibel OpenAI) ======
# Jika 9router jalan di host yang sama (bukan di Docker):
NINEROUTER_BASE_URL=http://9router:20128/v1
NINEROUTER_API_KEY=isi_api_key_9router
# Nama model harus PERSIS seperti yang ada di 9router (lihat daftar modelnya)
AI_MODEL_MEMBER=ag/gemini-3.8-flash-medium
AI_MODEL_STAFF=ag/gemini-3.8-flash-medium

# ====== Role & channel (isi dengan ID, pisahkan koma) ======
# Aktifkan Developer Mode di Discord, lalu klik kanan role/channel -> Copy ID
DEV_ROLE_IDS=
ADMIN_ROLE_IDS=
MODERATOR_ROLE_IDS=
PROGRAMMER_ROLE_IDS=
AI_CHANNEL_IDS=
# Channel bermode teknis (misalnya debug-help)
AI_TECH_CHANNEL_IDS=

# ====== Batas pemakaian (boleh dibiarkan, ini nilai awal) ======
LIMIT_MEMBER_DAILY=10
LIMIT_MEMBER_COOLDOWN_SEC=20
LIMIT_MEMBER_MAX_TOKENS=500
LIMIT_PROGRAMMER_DAILY=25
LIMIT_PROGRAMMER_COOLDOWN_SEC=15
LIMIT_PROGRAMMER_MAX_TOKENS=800
# dev: tanpa batas (biarkan kosong). Pemilik server otomatis dev.
LIMIT_ADMIN_DAILY=100
LIMIT_ADMIN_COOLDOWN_SEC=5
LIMIT_ADMIN_MAX_TOKENS=1200
LIMIT_MODERATOR_DAILY=50
LIMIT_MODERATOR_COOLDOWN_SEC=5
LIMIT_MODERATOR_MAX_TOKENS=1200
# Total semua non-staf per hari (pagar biaya)
LIMIT_GLOBAL_DAILY=300

# ====== Ingatan percakapan ======
AI_MEMORY_TURNS=3
AI_MEMORY_TTL_MIN=30
AI_MEMORY_MAX_CHARS=1200

# ====== Keandalan (opsional) ======
# Model cadangan di 9router, dipakai otomatis jika model utama gagal
AI_MODEL_FALLBACK=
# Jumlah permintaan AI diproses bersamaan, dan panjang antrean maksimum
AI_CONCURRENCY=2
AI_MAX_QUEUE=10
# Channel staf untuk peringatan "AI gagal berturut-turut" (bot perlu izin kirim pesan di sana)
STAFF_LOG_CHANNEL_ID=
# Lama log pertanyaan disimpan (hari) dan jumlah cadangan database yang disimpan
ASK_LOG_RETENTION_DAYS=30
BACKUP_KEEP=7

# ====== Panel role, sambutan, log moderasi ======
# Log moderasi memakai STAFF_LOG_CHANNEL_ID di atas.
# Sambutan, log masuk/keluar, dan log role butuh intent "Server Members":
#   Developer Portal -> Bot -> Privileged Gateway Intents -> SERVER MEMBERS INTENT (ON), lalu isi:
MEMBER_EVENTS=off
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
ROLES_CHANNEL_ID=

# ====== Musik (yt-dlp + ffmpeg, di dalam bot) ======
# MUSIC=on menyalakan /play /skip /stop /pause /volume /queue dan intent voice.
MUSIC=off
# Sumber pencarian judul: youtube (default) atau soundcloud. Tautan keduanya selalu diterima.
MUSIC_SOURCE=youtube
# Batasi perintah musik ke channel tertentu (kosong = di mana saja; staf selalu boleh)
MUSIC_CHANNEL_IDS=
MUSIC_MAX_QUEUE=30
MUSIC_MAX_TRACK_MIN=15
MUSIC_DEFAULT_VOLUME=60
MUSIC_MAX_VOLUME=100
